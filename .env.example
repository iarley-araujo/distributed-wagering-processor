# --- infraestrutura
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- instância
PORT=3000
INSTANCE_ID=local-1
APP_ROLES=api,consumer,outbox,pending-references
LOG_LEVEL=info

# --- banco
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- filas
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo

# --- consumer
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_BATCH_SIZE=10
CONSUMER_WAIT_TIME_SECONDS=10
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_BACKOFF_BASE_MS=1000
CONSUMER_BACKOFF_MAX_MS=60000
SHUTDOWN_GRACE_MS=20000

# --- outbox
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000

# --- referências pendentes (≈10 tentativas, backoff 2s → 5min ≈ 7–14 min no total)
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_BACKOFF_BASE_MS=2000
PENDING_REF_BACKOFF_MAX_MS=300000
PENDING_REF_MAX_ATTEMPTS=10

# --- só para testes (deixar vazio)
FAULT_INJECTION=
