{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate:up": "bun run scripts/migrate.ts up",
    "migrate:down": "bun run scripts/migrate.ts down",
    "migrate:status": "bun run scripts/migrate.ts status",
    "queues:create": "bun run scripts/create-queues.ts",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:load": "bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1178.0",
    "@mikro-orm/core": "6.6.19",
    "@mikro-orm/migrations": "6.6.19",
    "@mikro-orm/postgresql": "6.6.19",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/express": "5.0.3",
    "typescript": "5.9.3"
  }
}
